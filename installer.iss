; Script generated by the Inno Setup Script Wizard.
; A B INFOTECH SIGNER OFFLINE - Official Windows Setup Installer

#define MyAppName "A B INFOTECH SIGNER OFFLINE"
#define MyAppVersion "1.1"
#define MyAppPublisher "A B INFOTECH"
#define MyAppURL "https://www.a-b-infotech.in/"
#define MyAppExeName "Abinfo_Signer_Offline.exe"
#define MyAppIconName "icon.ico"

[Setup]
; Use {pf} for Program Files (Windows handles 32/64-bit redirection automatically) 
AppId={{6227A3C9-3081-4153-BC4B-C00102FBB300}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Safely targets "C:\Program Files" on all Windows machines
DefaultDirName={pf}\{#MyAppName}
DefaultGroupName={#MyAppName}

OutputDir=downloads
OutputBaseFilename=Abinfo_Signer_Windows_Setup
SetupIconFile=icon.ico
UninstallDisplayIcon={app}\{#MyAppIconName}
Compression=lzma
SolidCompression=yes

; Require admin privileges so certutil can install the certificate to the Root store
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Ensure the exe and the icon are installed in the destination folder
Source: "dist\Abinfo_Signer_Offline.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "icon.ico"; DestDir: "{app}"; Flags: ignoreversion

; Certificate to be installed (put in {tmp} so it deletes itself automatically after installation)
Source: "ab_infotech_ca_cert.cer"; DestDir: "{tmp}"; Flags: deleteafterinstall

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppIconName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\{#MyAppIconName}"

[Registry]
; This makes your app start automatically in the background when Windows boots
Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; \
    ValueType: string; ValueName: "Abinfo_Signer_Offline"; \
    ValueData: """{app}\{#MyAppExeName}"" --background"; Flags: uninsdeletevalue

[Run]
; Auto-installs the certificate to the Windows Trusted Root store quietly
Filename: "certutil.exe"; Parameters: "-addstore Root ""{tmp}\ab_infotech_ca_cert.cer"""; Flags: runhidden; StatusMsg: "Verifying A B INFOTECH Security Certificate..."

; Launch the app automatically after installation
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; Forcefully kill the application and its background server tree (/T) silently (/runhidden) before uninstalling
Filename: "{cmd}"; Parameters: "/C taskkill /F /IM {#MyAppExeName} /T"; Flags: runhidden

[UninstallDelete]
; Delete the license icon file and its hidden folder
Type: filesandordirs; Name: "{%userprofile}\.abinfotech_signer"
; Delete the entire application directory and all its contents
Type: filesandordirs; Name: "{app}"
